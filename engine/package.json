{
  "name": "@guga/engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && cp -R prompts rules dist/ && mkdir -p dist/db && cp -R src/db/migrations dist/db/",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web": "node dist/web.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "fastify": "^4.28.1",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "ulid": "^2.3.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8",
    "dompurify": "^3.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
