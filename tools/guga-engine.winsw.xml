<!-- WinSW : enregistrement du moteur Guga en service Windows (§3.2, §3.4, §13.1).
     Installation : tools\winsw.exe install tools\guga-engine.winsw.xml -->
<service>
  <id>guga-engine</id>
  <name>Guga Engine</name>
  <description>Moteur Guga : synchronisation Outlook, classification IA locale, API 127.0.0.1:8765</description>
  <executable>%BASE%\..\engine\node.exe</executable>
  <arguments>"%BASE%\..\engine\index.js"</arguments>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <env name="GUGA_DATA_DIR" value="%LOCALAPPDATA%\Guga"/>
  <env name="GUGA_LOG_LEVEL" value="info"/>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>8</keepFiles></log>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
</service>
